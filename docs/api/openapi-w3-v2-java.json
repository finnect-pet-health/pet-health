          "dob" : {
            "type" : "string",
            "format" : "date"
          },
          "weight" : {
            "type" : "number",
            "format" : "double"
          },
          "neutered" : {
            "type" : "boolean"
          },
          "conditions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
