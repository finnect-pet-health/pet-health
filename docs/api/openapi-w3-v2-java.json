        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "family_id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "species" : {
            "type" : "string"
          },
          "breed" : {
            "type" : "string"
          },
          "dob" : {
            "type" : "string",
            "format" : "date"
          },
          "weight" : {
            "type" : "number",
            "format" : "double"
          },
          "neutered" : {
            "type" : "boolean"
          },
          "conditions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "breed", "conditions", "dob", "family_id", "id", "neutered", "species", "weight" ]
