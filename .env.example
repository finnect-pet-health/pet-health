# ------------------------------------------------------------
# PetFinect — Environment Variables Example
# Copy to `.env` and fill in real values.
# ------------------------------------------------------------

# === Cloud Backend (apps/api) ===
APP_ENV=development
JWT_SECRET=replace-with-strong-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

POSTGRES_DSN=postgresql+asyncpg://petfinect:petfinect@localhost:5434/petfinect
REDIS_URL=redis://localhost:6382/0
S3_BUCKET=petfinect-dev
S3_REGION=ap-northeast-2

# Local AI server endpoint (Cloudflare Tunnel URL or http://localhost:8800)
AI_SERVER_URL=http://localhost:8800
AI_SERVER_SHARED_SECRET=replace-with-shared-secret

# === Kakao OAuth & Map ===
KAKAO_REST_API_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.petfinect/v1/auth/kakao/callback

# === Caretail (반려동물 워치) — 2026-05-07 프로젝트에서 제외, 본선/Phase 2 부활 시 사용 ===
# CARETAIL_CLIENT_ID=
# CARETAIL_CLIENT_SECRET=
# CARETAIL_BASE_URL=https://api.caretail.example/v1

# === FatSecret (영양 데이터) ===
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# === 공공데이터포털 (동물병원) ===
DATA_GO_KR_API_KEY=

# === Push Notifications (Expo / FCM / APNs) ===
EXPO_ACCESS_TOKEN=

# === Sentry ===
SENTRY_DSN=

# ------------------------------------------------------------
# Mobile (apps/mobile) — separate Expo `app.config.ts` extra
# ------------------------------------------------------------
EXPO_PUBLIC_API_BASE=http://localhost:8000
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=
