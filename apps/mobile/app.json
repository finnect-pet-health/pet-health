{
  "expo": {
    "name": "PetFinect",
    "slug": "petfinect",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "petfinect",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petfinect"
    },
    "android": {
      "package": "app.petfinect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "$EXPO_PUBLIC_API_BASE",
      "kakaoNativeAppKey": "$EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY",
      "kakaoJsKey": "$EXPO_PUBLIC_KAKAO_JS_KEY"
    }
  }
}
